# Sanity CMS Configuration
# Documentation: https://www.sanity.io/docs

# Your Sanity project ID
# Obtain from: https://www.sanity.io/manage -> Select/Create Project -> Settings -> API -> Project ID
# This is safe to commit and expose to the client (prefixed with NEXT_PUBLIC_)
NEXT_PUBLIC_SANITY_PROJECT_ID=your_project_id_here

# Your Sanity dataset name
# Obtain from: https://www.sanity.io/manage -> Select Project -> Datasets
# Common values: 'production', 'staging', 'development'
# This is safe to commit and expose to the client (prefixed with NEXT_PUBLIC_)
NEXT_PUBLIC_SANITY_DATASET=production

# Sanity API Read Token (Viewer permissions)
# Obtain from: https://www.sanity.io/manage -> Select Project -> Settings -> API -> Tokens -> Add API token
# When creating the token:
#   - Name: "Next.js Read Token"
#   - Permissions: "Viewer" (read-only access)
# NEVER commit this token to version control
SANITY_API_READ_TOKEN=your_read_token_here

# Sanity API Write Token (Editor permissions)
# Obtain from: https://www.sanity.io/manage -> Select Project -> Settings -> API -> Tokens -> Add API token
# When creating the token:
#   - Name: "Next.js Write Token"
#   - Permissions: "Editor" (read + write access)
# NEVER commit this token to version control
SANITY_API_WRITE_TOKEN=your_write_token_here

# Site URL (used for metadata, sitemap, and canonical URLs)
# In production, set to your deployed domain (e.g., https://example.com)
# Defaults to http://localhost:3000 if not set
# NEXT_PUBLIC_SITE_URL=https://example.com

# IMPORTANT: After creating your Sanity project, add CORS origin for local development:
# https://www.sanity.io/manage -> Select Project -> Settings -> API -> CORS Origins
# Add: http://localhost:3000 with "Allow credentials" enabled
